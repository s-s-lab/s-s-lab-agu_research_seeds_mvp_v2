{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agu-research-seeds-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://s-s-lab.github.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
